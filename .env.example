# Database
DATABASE_URL="postgresql://user:password@host:5432/konga_coffee?sslmode=require"
# Direct PostgreSQL URL for Prisma pg adapter (required if DATABASE_URL uses prisma+postgres://)
DIRECT_DATABASE_URL=

# Auth.js
AUTH_SECRET="generate-a-secure-random-string-here"
AUTH_URL="http://localhost:3000"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Lambek Coffee"

# Seed admin (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@kongacoffee.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Storage
STORAGE_PROVIDER="local"
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_LOCAL_PATH="./public/uploads"

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL="info@Lambekcoffee.com"
